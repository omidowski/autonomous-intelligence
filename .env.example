# Providers: codex (local Codex CLI), openai (API key), or demo.
AI_PROVIDER=codex
CODEX_CLI_PATH=codex
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=180

# Only used when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

APP_ENV=development
MAX_RESEARCH_ITERATIONS=2
MIN_EVIDENCE_ITEMS=3

# Daily content pipeline
DAILY_TRENDS_COUNT=3
DAILY_CONTENT_OUTPUT_DIR=output

# Optional: AI image-generation fallback (tried before Pexels) when
# OpenAI image generation is unavailable. Free key at https://leonardo.ai/
# - leave empty to skip straight to the Pexels/placeholder fallback.
LEONARDO_API_KEY=

# Optional: stock-photo fallback when AI image generation is unavailable
# (e.g. gpt-image-1 pending OpenAI org verification). Free key at
# https://www.pexels.com/api/ - leave empty to keep the placeholder-only
# fallback.
PEXELS_API_KEY=

# Optional: TTS fallback when OpenAI speech synthesis is unavailable (e.g.
# this OpenAI project has no access to gpt-4o-mini-tts/tts-1). Free key at
# https://elevenlabs.io/ - leave empty to keep the silent-placeholder-only
# fallback.
ELEVENLABS_API_KEY=

# Optional: real AI video generation (image-to-video) instead of the
# moviepy slideshow assembly. NO FREE TIER - real cost per generation, only
# used when explicitly set. Get a key at https://runwayml.com/.
RUNWAY_API_KEY=

# Optional: alternative image-to-video upgrade to Runway. Both keys
# required together (JWT auth). NO FREE TIER. Get keys at
# https://kling.ai/document-api/.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Optional: AI-avatar talking-head video instead of b-roll motion - tried
# first when configured (see daily_content_orchestrator.py). Both keys
# required together; an avatar must be created in HeyGen's own dashboard
# first. NO FREE TIER. Get a key and avatar at https://app.heygen.com/.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Auth, scheduling, storage
DATABASE_PATH=data/app.db
BRAND_ASSETS_DIR=assets
SESSION_COOKIE_NAME=ai_session
SESSION_TTL_DAYS=14

# Optional: OpenRouter gateway for selecting Claude/Gemini/Grok/GPT as the
# per-company content model. Get a key at https://openrouter.ai/.
OPENROUTER_API_KEY=

# Absolute base URL this app is served at - required for Stripe
# Checkout/portal redirect URLs. Set to the real public URL in production.
APP_BASE_URL=http://localhost:8000

# Optional: real subscription billing via Stripe. All three required
# together for payments to work; leaving STRIPE_SECRET_KEY empty disables
# /billing/checkout and /billing/portal (503) rather than faking success.
# Get keys at https://dashboard.stripe.com/apikeys and
# https://dashboard.stripe.com/webhooks.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
